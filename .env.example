# Copy these into Vercel > Project > Settings > Environment Variables. NEVER commit real values to Git.

# --- Database (required in production) ---
# Postgres connection string from Supabase or Neon (use the "pooled"/"transaction" URL).
DATABASE_URL=postgres://user:password@host:6543/postgres?sslmode=require

# --- Admin login (required) ---
# Long random text, at least 32 characters. Used to sign the login cookie.
SESSION_SECRET=
# Either a password of 12+ characters ...
ADMIN_PASSWORD=
# ... or (better) a hash made with:  node scripts/hash-password.js "your long password"
ADMIN_PASSWORD_HASH=

# --- Email to the host (pick one provider) ---
EMAIL_PROVIDER=none          # web3forms | resend | none
WEB3FORMS_ACCESS_KEY=        # if EMAIL_PROVIDER=web3forms
RESEND_API_KEY=              # if EMAIL_PROVIDER=resend
MAIL_FROM=                   # e.g. "Manila Prime <bookings@yourdomain.com>" (resend)
NOTIFY_TO=                   # host email that receives booking requests (resend)

# --- Optional ---
SITE_URL=https://your-domain.example   # used in email links
HOLD_HOURS=24                          # how long a pending request holds its dates
DEFAULT_WEEKDAY_RATE=1999              # only used the first time units are created
DEFAULT_WEEKEND_RATE=1999              # only used the first time units are created
